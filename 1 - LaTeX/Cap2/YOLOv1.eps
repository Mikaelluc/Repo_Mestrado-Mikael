%%BeginSetup
%%EndSetup
%%Page: 1 1
%%BeginPageSetup
%%PageBoundingBox: 0 0 1195 494
%%EndPageSetup
q 0 0 1195 494 rectclip
1 0 0 -1 0 494 cm q
Q q
q
0 0 1195 494 re W n
[ 1194.75 0 0 -493.5 0 493.5 ] concat
